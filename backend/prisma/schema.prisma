// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
        provider = "prisma-client"
        output   = "../src/generated/prisma"
}

datasource db {
        provider = "postgresql"
}


enum Status {
        open
        closed
        cancelled
        partial_filled
}
enum Type {
        market
        limit
}
enum Side {
        buy
        sell 
}



model User {
        id                     String             @default(uuid()) @id
        username        String         @unique
        password        String
        orders            Order[]
        fills                 Fill[]
}

model Stock{
        id              String     @default(uuid()) @id
        name         String @unique
        symbol       String @unique
}


model Order{
        id                      String             @default(uuid()) @id
        userId              String
        market             String
        price                Int?
        quantity           Int
        type                Type 
        side                 Side
        filledQuantity Int
        remainingQuantity Int
        status             Status      
        createdAt       DateTime @default(now())
        user     User    @relation(fields: [userId],references: [id])
        fills    Fill[]
}

//Trades
model Fill{
        id                              String                     @default(uuid()) @id
        quantity                    Int                      
        side                          Side
        type                         Type
        userId                     String
        price                        Int
        market                    String
        originalOrderID      String
        createdAt               DateTime @default(now())
        user    User    @relation(fields: [userId],references: [id])
        original  Order  @relation(fields:[originalOrderID],references: [id])
}
