      "text": "matchBuy(order:newOrderCreated){\n\n              // valid and funds are locked for the user lets match the order into the order book \n              // checking that someone has matching ask into the order book or not\n               const asks = ORDERBOOK[order.market] -  min-max\n  \n               while(order.remainigQuantity>0 && asks.length>0){\n                    \n                    const currentBestAsk = asks[0]\n\n                    if(currentBestAsk.price>order.price ) break;// we are able to setlled down this order - aage to expensive ask hai\n                    \n                    // lets setlle this ask - either close this order or open (partilally filled)\n                    await settleThisOrder(order,currentBestAsk) // =>(buyOrder,sellOrder)\n\n                    if(currentBestAsk.remainingQuantity===0) so this ask full filled so can be setteled down and remov from orderbook\n                        asks.shift()\n                  \n                }\n\n                if(order.remainigQuantity>0){\n                        // update the orderbook that still need to work on this buy order\n                        ORDERBOOK[order.market].bids.push(order)\n                        ORDERBOOK[order.market].bids.sort((a,b)=>b.price-a.price))// desending order\n                        \n                }else{\n                       ORDERBOOK[order.market].bids = ORDERBOOK[order.market].bids.filter(bid=>bid.id != order.id)\n                }\n            \n    \n}",
