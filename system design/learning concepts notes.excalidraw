    {
      "id": "I5nzK2Zp5XvXfiVXnI0p8",
      "type": "text",
      "x": 542439.7562814405,
      "y": 48134.45862111472,
      "width": 788.5791015625,
      "height": 750,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAo",
