      "isDeleted": false,
      "boundElements": [],
      "updated": 1785138699709,
      "link": null,
      "locked": false,
      "text": "That's why matching engines usually keep the\nhot, constantly-changing state in memory.",
      "fontSize": 87.33337402343747,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "That's why matching engines usually keep the hot, constantly-changing state in memory.",
      "autoResize": false,
      "lineHeight": 1.25
    },
