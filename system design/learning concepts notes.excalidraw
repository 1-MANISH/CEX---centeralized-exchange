      "boundElements": [],
      "updated": 1785310140557,
      "link": null,
      "locked": false,
      "text": "ORDERBOOK = {\n\n      BTC: { \n        bids:[],\n        asks:[],\n        lastTradePrice:null \n      },\n      SOL: { \n        bids:[\n            {\n                userId:1,\n                type:\"limit\",\n                side:\"buy\",\n                market:\"SOL\",\n                price:10,\n                quantity:2,\n                filledQuantity:0\n                remainingQuantity:2,\n                status:\"open\"\n            }\n        ],\n        asks:[\n            {\n                userId:2,\n                type:\"limit\",\n                side:\"sell\",\n                market:\"SOL\",\n                price:12,\n                quantity:2,\n                filledQuantity:0\n                remainingQuantity:2,\n                status:\"open\"\n            }\n        ],\n        lastTradePrice:null \n      }\n\n}",
      "fontSize": 24.33875106324973,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORDERBOOK = {\n\n      BTC: { \n        bids:[],\n        asks:[],\n        lastTradePrice:null \n      },\n      SOL: { \n        bids:[\n            {\n                userId:1,\n                type:\"limit\",\n                side:\"buy\",\n                market:\"SOL\",\n                price:10,\n                quantity:2,\n                filledQuantity:0\n                remainingQuantity:2,\n                status:\"open\"\n            }\n        ],\n        asks:[\n            {\n                userId:2,\n                type:\"limit\",\n                side:\"sell\",\n                market:\"SOL\",\n                price:12,\n                quantity:2,\n                filledQuantity:0\n                remainingQuantity:2,\n                status:\"open\"\n            }\n        ],\n        lastTradePrice:null \n      }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
