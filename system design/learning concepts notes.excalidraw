      "text": "Balances = {\n\n    1 : {\n        USD:{available:80,locked:20},\n        BTC:{available:20,locked:0},\n        SOL:{available:20,locked:0}\n    },\n   2 : {\n        USD:{available:100,locked:0},\n        BTC:{available:20,locked:0},\n        SOL:{available:18,locked:2}\n    },\n    3 : {\n        USD:{available:100,locked:0},\n        BTC:{available:20,locked:0}\n        SOL:{available:20,locked:0}\n    }\n\n}",
