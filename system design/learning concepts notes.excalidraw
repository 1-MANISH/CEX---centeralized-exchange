    {
      "id": "-A9WZIQtIT6aqJQtHfAPE",
      "type": "text",
      "x": 540539.928210298,
      "y": 47255.94929920856,
      "width": 1189.990966796875,
      "height": 739.079789985524,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAY",
      "roundness": null,
      "seed": 1340077809,
      "version": 1246,
      "versionNonce": 2071205375,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785260086001,
      "link": null,
      "locked": false,
      "text": "lockFunds(order:initialOrderBody){\n    \n    if(order.side==\"buy\"){\n            let amountNeeded = 0\n            if(order.type==\"limit\")amountNeeded+=order.quantity*order.price\n            else // market order - buy kroo jitna bhi lgee amount+=estimateMarketBuyCost(order)\n\n            //now check that - bhai ke pass itna funds bhi hai ya nhi\n            const userBalance = BALANCES[order.userId].USD\n            if(userBalance.available < amountNeeded) throw new Error(\"Error in locking : Not sufficient funds\")\n\n            userBalance.available-=amountNeeded\n            userBalance.locked+=amountNeeded;\n    }\n    else{\n\n        // order.side==\"sell\" -> SOL or ETH quantity only needed to check becuase wants to sell it\n\n           if(order.type==\"limit\") // means sell this much my assets if available and minimum this much i wanted to have per asset\n           else just sell it -> with best price matched  - best bids\n          const userAssetBalance = BALANCES[order.userId][order.market]\n            \n          if(userAssetBalance .available < order.quantity) throw new Error(\"Error in locking : Not sufficient funds\")\n          \n          userAssetBalance .available-=order.quantity\n          userAssetBalance .locked+=order.quantity;\n    }\n}",
      "fontSize": 21.11656542815783,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "lockFunds(order:initialOrderBody){\n    \n    if(order.side==\"buy\"){\n            let amountNeeded = 0\n            if(order.type==\"limit\")amountNeeded+=order.quantity*order.price\n            else // market order - buy kroo jitna bhi lgee amount+=estimateMarketBuyCost(order)\n\n            //now check that - bhai ke pass itna funds bhi hai ya nhi\n            const userBalance = BALANCES[order.userId].USD\n            if(userBalance.available < amountNeeded) throw new Error(\"Error in locking : Not sufficient funds\")\n\n            userBalance.available-=amountNeeded\n            userBalance.locked+=amountNeeded;\n    }\n    else{\n\n        // order.side==\"sell\" -> SOL or ETH quantity only needed to check becuase wants to sell it\n\n           if(order.type==\"limit\") // means sell this much my assets if available and minimum this much i wanted to have per asset\n           else just sell it -> with best price matched  - best bids\n          const userAssetBalance = BALANCES[order.userId][order.market]\n            \n          if(userAssetBalance .available < order.quantity) throw new Error(\"Error in locking : Not sufficient funds\")\n          \n          userAssetBalance .available-=order.quantity\n          userAssetBalance .locked+=order.quantity;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DBNBNWtgwFqzlqqtQUVu-",
