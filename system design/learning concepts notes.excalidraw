    {
      "id": "TtrXTcumk64rG5JIER9AL",
      "type": "text",
      "x": 540006.1997602445,
      "y": 46433.87272128031,
      "width": 624.3390502929688,
      "height": 150,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB0",
      "roundness": null,
      "seed": 1525229503,
      "version": 301,
      "versionNonce": 1877362641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785266444567,
      "link": null,
      "locked": false,
      "text": "Things we have in mind that any buy or sell order\nirerespetive of limit or market order can be partially filled or full filled\n\n\nif partially filled then remain in orderbook\nif fully filled then remove from orderbook",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Things we have in mind that any buy or sell order\nirerespetive of limit or market order can be partially filled or full filled\n\n\nif partially filled then remain in orderbook\nif fully filled then remove from orderbook",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QIYnnGf7XcAUJKbiElymM",
      "type": "text",
      "x": 540228.7991900974,
      "y": 46654.324034868594,
      "width": 646.6591796875,
      "height": 400,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBD",
      "roundness": null,
      "seed": 364763985,
      "version": 19,
      "versionNonce": 66929713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785266445056,
      "link": null,
      "locked": false,
      "text": "Any BUY or SELL order, whether LIMIT or MARKET, can be either:\n\n1. Fully Filled\n2. Partially Filled\n\nIf a LIMIT order is partially filled,\nthe remaining quantity stays in the order book.\n\nIf a LIMIT order is fully filled,\nit is removed from the order book.\n\nIf a MARKET order is partially filled,\nthe remaining quantity is cancelled (it does NOT stay in the order book).\n\nIf a MARKET order is fully filled,\nit simply completes and is removed.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Any BUY or SELL order, whether LIMIT or MARKET, can be either:\n\n1. Fully Filled\n2. Partially Filled\n\nIf a LIMIT order is partially filled,\nthe remaining quantity stays in the order book.\n\nIf a LIMIT order is fully filled,\nit is removed from the order book.\n\nIf a MARKET order is partially filled,\nthe remaining quantity is cancelled (it does NOT stay in the order book).\n\nIf a MARKET order is fully filled,\nit simply completes and is removed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
