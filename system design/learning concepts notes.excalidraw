      "link": null,
      "locked": false,
      "text": "matchSell(order:newOrderCreated){\n\n        // valid and funds are locked for the user lets match the order into the order book \n        // checking that someone has matching buys into the order book or not\n        const bids = ORDERBOOK[order.market].bids -  max-min - willing to buy\n        if(order.type===\"limit\"){\n                // means will sell if available someone who can pay me this much\n               while(order.remainigQuantity>0 && bids .length>0){\n                    \n                    const currentBestBid = bids [0]\n\n                    if(currentBestBid.price<order.price ) break;// we are able to setlled down this order - aage to cheeper log hai                    \n                    // lets setlle this ask - either close this order or open (partilally filled)\n                    await settleThisOrder(currentBestBid ,order) // =>(buyOrder,sellOrder)\n\n                    if(currentBestBid.remainingQuantity===0) so this bid full filled so can be setteled down and remov from orderbook\n                        bids.shift()\n                  \n                }\n\n                if(order.remainigQuantity>0){\n                        // update the orderbook that still need to work on this buy order\n                        ORDERBOOK[order.market].asks.push(order)\n                        ORDERBOOK[order.market].asks.sort((a,b)=>a.price-b.price))// ascsending order\n                        \n                }else{\n                       ORDERBOOK[order.market].asks = ORDERBOOK[order.market].asks.filter(ask=>ask.id != order.id)\n                }\n            \n        }else{ // market order - try to full filled whatever portion \n                // means will sell if available someone who can pay me this much\n               while(order.remainigQuantity>0 && bids .length>0){\n                    \n                    const currentBestBid = bids [0]\n\n                    await settleThisOrder(currentBestBid ,order) // =>(buyOrder,sellOrder)\n\n                    if(currentBestBid.remainingQuantity===0) so this bid full filled so can be setteled down and remov from orderbook\n                        bids.shift()\n                  \n                }\n\n                if(order.remainigQuantity>0){\n                        // update the orderbook that still need to work on this buy order\n                        ORDERBOOK[order.market].asks.push(order)\n                        ORDERBOOK[order.market].asks.sort((a,b)=>a.price-b.price))// ascsending order\n                        \n                }else{\n                       ORDERBOOK[order.market].asks = ORDERBOOK[order.market].asks.filter(ask=>ask.id != order.id)\n                }\n\n        }\n\n}",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "matchSell(order:newOrderCreated){\n\n        // valid and funds are locked for the user lets match the order into the order book \n        // checking that someone has matching buys into the order book or not\n        const bids = ORDERBOOK[order.market].bids -  max-min - willing to buy\n        if(order.type===\"limit\"){\n                // means will sell if available someone who can pay me this much\n               while(order.remainigQuantity>0 && bids .length>0){\n                    \n                    const currentBestBid = bids [0]\n\n                    if(currentBestBid.price<order.price ) break;// we are able to setlled down this order - aage to cheeper log hai                    \n                    // lets setlle this ask - either close this order or open (partilally filled)\n                    await settleThisOrder(currentBestBid ,order) // =>(buyOrder,sellOrder)\n\n                    if(currentBestBid.remainingQuantity===0) so this bid full filled so can be setteled down and remov from orderbook\n                        bids.shift()\n                  \n                }\n\n                if(order.remainigQuantity>0){\n                        // update the orderbook that still need to work on this buy order\n                        ORDERBOOK[order.market].asks.push(order)\n                        ORDERBOOK[order.market].asks.sort((a,b)=>a.price-b.price))// ascsending order\n                        \n                }else{\n                       ORDERBOOK[order.market].asks = ORDERBOOK[order.market].asks.filter(ask=>ask.id != order.id)\n                }\n            \n        }else{ // market order - try to full filled whatever portion \n                // means will sell if available someone who can pay me this much\n               while(order.remainigQuantity>0 && bids .length>0){\n                    \n                    const currentBestBid = bids [0]\n\n                    await settleThisOrder(currentBestBid ,order) // =>(buyOrder,sellOrder)\n\n                    if(currentBestBid.remainingQuantity===0) so this bid full filled so can be setteled down and remov from orderbook\n                        bids.shift()\n                  \n                }\n\n                if(order.remainigQuantity>0){\n                        // update the orderbook that still need to work on this buy order\n                        ORDERBOOK[order.market].asks.push(order)\n                        ORDERBOOK[order.market].asks.sort((a,b)=>a.price-b.price))// ascsending order\n                        \n                }else{\n                       ORDERBOOK[order.market].asks = ORDERBOOK[order.market].asks.filter(ask=>ask.id != order.id)\n                }\n\n        }\n\n}",
