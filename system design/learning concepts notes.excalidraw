    {
      "id": "5vu0tRVYQKxBQHyvmA7Wf",
      "type": "text",
      "x": 541880.1699909541,
      "y": 47406.907896220364,
      "width": 1077.4390575717985,
      "height": 531.8178989342778,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAa",
      "roundness": null,
      "seed": 1461560625,
      "version": 690,
      "versionNonce": 3729983,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785260975567,
      "link": null,
      "locked": false,
      "text": "estimateMarketBuyCost(order:initialOrderBody){\n    \n    // for this market order - min amount needed to buy something\n    const asks = ORDERBOOK[order.market].asks // min-max\n    \n    const remaingQuantity = order.quantity\n    const amountNeeded  = 0;\n    \n    while(asks.length>0 && remainingQuantity>0){\n            if(remainingQuantity === 0 ) break;\n            int quantity = min(remainingQuantity,asks.remainingQuantity)\n            amountNeeded+=quantity*asks.price\n            remainingQuantity-=quantity\n    }\n    if(remainingQuantity > 0 ) throw new Error(\"Insufficient funds : not enough orderbook to fill order\")\n    return amountNeeded\n   \n}",
      "fontSize": 23.6363510637457,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "estimateMarketBuyCost(order:initialOrderBody){\n    \n    // for this market order - min amount needed to buy something\n    const asks = ORDERBOOK[order.market].asks // min-max\n    \n    const remaingQuantity = order.quantity\n    const amountNeeded  = 0;\n    \n    while(asks.length>0 && remainingQuantity>0){\n            if(remainingQuantity === 0 ) break;\n            int quantity = min(remainingQuantity,asks.remainingQuantity)\n            amountNeeded+=quantity*asks.price\n            remainingQuantity-=quantity\n    }\n    if(remainingQuantity > 0 ) throw new Error(\"Insufficient funds : not enough orderbook to fill order\")\n    return amountNeeded\n   \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AgXfkXYHgQAg5FkJYT7Qk",
      "type": "text",
      "x": 539977.6068756467,
      "y": 44854.94552672883,
      "width": 332.3962707519531,
