    {
      "id": "AcvQkgUlz7vODXXVvd9YD",
      "type": "text",
      "x": 324.6557377049181,
      "y": 16833,
      "width": 616.3795776367188,
      "height": 725,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2U",
      "roundness": null,
      "seed": 1849255925,
      "version": 843,
      "versionNonce": 1544596757,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784968314662,
      "link": null,
      "locked": false,
      "text": "app.post('/order/market',(req,res)=>{\n\n    const userId = req.user --> middleware check authentication\n    const{price,qty,asset,side}=req.body\n\n    const usdBalance = await db.usdBalance.find({userId})\n    \n    if(usdBalamnce >= price*qty){\n        \n        // matching\n        const orderBook = await db.orderbook.find({assets})\n\n        // matching 0- update order book\n\n        filledQty ,  new_orderbook\n        transaction([\n        // reduce usd balance\n        db.useBalance.decrease()\n        db.stockbalance.update({})\n        db.stockbalance.update({})\n        db.orderbook.update();\n       ])\n\n       res.status(200).json()\n    }else{\n         res.status(403).json({message:\"No sufficient balance\"})\n    }\n\n})",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "app.post('/order/market',(req,res)=>{\n\n    const userId = req.user --> middleware check authentication\n    const{price,qty,asset,side}=req.body\n\n    const usdBalance = await db.usdBalance.find({userId})\n    \n    if(usdBalamnce >= price*qty){\n        \n        // matching\n        const orderBook = await db.orderbook.find({assets})\n\n        // matching 0- update order book\n\n        filledQty ,  new_orderbook\n        transaction([\n        // reduce usd balance\n        db.useBalance.decrease()\n        db.stockbalance.update({})\n        db.stockbalance.update({})\n        db.orderbook.update();\n       ])\n\n       res.status(200).json()\n    }else{\n         res.status(403).json({message:\"No sufficient balance\"})\n    }\n\n})",
      "autoResize": true,
      "lineHeight": 1.25
    },
